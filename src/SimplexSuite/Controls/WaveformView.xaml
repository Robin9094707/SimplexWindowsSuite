<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="SimplexSuite.Controls.WaveformView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="True"
    UseSystemFocusVisuals="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="26" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Canvas x:Name="RulerCanvas" Grid.Row="0" Background="Transparent" PointerPressed="Ruler_PointerPressed" />
        <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <Grid x:Name="WaveHost" Grid.Row="1" Background="Transparent"
              PointerPressed="Wave_PointerPressed" PointerMoved="Wave_PointerMoved" PointerReleased="Wave_PointerReleased"
              PointerWheelChanged="Wave_PointerWheelChanged" SizeChanged="Wave_SizeChanged" DoubleTapped="Wave_DoubleTapped">
            <Image x:Name="WaveImage" Stretch="Fill" IsHitTestVisible="False" />
            <Canvas x:Name="Overlay" IsHitTestVisible="False">
                <Rectangle x:Name="SelectionRect" Visibility="Collapsed" Opacity="0.28" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                <Canvas x:Name="MarkerCanvas" />
                <Rectangle x:Name="CursorLine" Width="1" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                <Rectangle x:Name="PlayheadLine" Width="2" Visibility="Collapsed" Fill="{ThemeResource SystemFillColorCriticalBrush}" />
            </Canvas>
            <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Keine Audiodatei geladen" />
        </Grid>

        <ScrollBar x:Name="HScroll" Grid.Row="2" Orientation="Horizontal" IndicatorMode="MouseIndicator"
                   ValueChanged="HScroll_ValueChanged" Margin="0,4,0,0" />
    </Grid>
</UserControl>
