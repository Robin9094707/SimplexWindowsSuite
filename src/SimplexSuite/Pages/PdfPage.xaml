<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SimplexSuite.Pages.PdfPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pdf="using:SimplexSuite.Core.Pdf"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    Background="Transparent"
    AllowDrop="True" DragOver="Page_DragOver" Drop="Page_Drop">

    <Page.Resources>
        <Style x:Key="ToolButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Page.Resources>

    <Grid Padding="24,16,24,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="PDF" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="DocNameText" VerticalAlignment="Bottom" Margin="0,0,0,4" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <CommandBar Grid.Row="1" HorizontalAlignment="Left" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True">
            <AppBarButton Label="Öffnen" Click="Open_Click" ToolTipService.ToolTip="PDF oder Bilder öffnen (Strg+O)">
                <AppBarButton.Icon><FontIcon Glyph="&#xE8E5;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Hinzufügen" Click="Append_Click" ToolTipService.ToolTip="Weitere PDFs oder Bilder anhängen (Zusammenführen)">
                <AppBarButton.Icon><FontIcon Glyph="&#xE8F4;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Speichern" Click="Save_Click" ToolTipService.ToolTip="Als PDF speichern (Strg+S)">
                <AppBarButton.Icon><FontIcon Glyph="&#xE74E;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton Label="Links drehen" Click="RotateLeft_Click">
                <AppBarButton.Icon><FontIcon Glyph="&#xE7AD;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Rechts drehen" Click="RotateRight_Click">
                <AppBarButton.Icon><FontIcon Glyph="&#xE7AD;" RenderTransformOrigin="0.5,0.5"><FontIcon.RenderTransform><ScaleTransform ScaleX="-1" /></FontIcon.RenderTransform></FontIcon></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Seite löschen" Click="DeletePages_Click" ToolTipService.ToolTip="Ausgewählte Seiten löschen">
                <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="UndoButton" Label="Rückgängig" Click="Undo_Click" ToolTipService.ToolTip="Strg+Z">
                <AppBarButton.Icon><FontIcon Glyph="&#xE7A7;" /></AppBarButton.Icon>
            </AppBarButton>
            <CommandBar.SecondaryCommands>
                <AppBarButton Label="Leere Seite einfügen" Click="InsertBlank_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE7C3;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Seiten duplizieren" Click="Duplicate_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8C8;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Reihenfolge umkehren" Click="Reverse_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8CB;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton Label="Auswahl als neue PDF speichern …" Click="Extract_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8A5;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="In Einzelseiten aufteilen …" Click="Split_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8C6;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Seiten als Bilder exportieren …" Click="ExportImages_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xEB9F;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton Label="Texterkennung: ganzes Dokument durchsuchbar machen" Click="OcrAll_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8FD;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Alle Anmerkungen der Seite entfernen" Click="ClearAnnotations_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xED62;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Label="Dokument schließen" Click="Close_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE711;" /></AppBarButton.Icon>
                </AppBarButton>
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- Seitenübersicht -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="PagesHeader" Text="Seiten" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="14,10,8,6" />
                    <GridView x:Name="PageGrid" Grid.Row="1" SelectionMode="Extended" CanReorderItems="True" CanDragItems="True" AllowDrop="True"
                              Padding="10,0,4,8" SelectionChanged="PageGrid_SelectionChanged" DragItemsCompleted="PageGrid_DragItemsCompleted"
                              ContainerContentChanging="PageGrid_ContainerContentChanging">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="pdf:PdfPageItem">
                                <StackPanel Width="170" Spacing="4" Padding="0,4,0,4">
                                    <Grid Height="200" Width="170">
                                        <Border x:Name="ThumbFrame" Background="White" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                            <Image x:Name="ThumbImage" Stretch="Uniform" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{x:Bind Label, Mode=OneWay}" HorizontalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Grid>
            </Border>

            <!-- Seiteneditor -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="8,6,8,6" ColumnSpacing="8">
                        <StackPanel x:Name="ToolBar" Orientation="Horizontal" Spacing="2">
                            <ToggleButton Tag="Select" Style="{StaticResource ToolButtonStyle}" IsChecked="True" Click="Tool_Click" ToolTipService.ToolTip="Auswählen und verschieben (V)"><FontIcon Glyph="&#xE8B0;" FontSize="16" /></ToggleButton>
                            <ToggleButton Tag="Text" Style="{StaticResource ToolButtonStyle}" Click="Tool_Click" ToolTipService.ToolTip="Text hinzufügen"><FontIcon Glyph="&#xE8D2;" FontSize="16" /></ToggleButton>
                            <ToggleButton Tag="Ink" Style="{StaticResource ToolButtonStyle}" Click="Tool_Click" ToolTipService.ToolTip="Freihand zeichnen"><FontIcon Glyph="&#xEE56;" FontSize="16" /></ToggleButton>
                            <ToggleButton Tag="Highlight" Style="{StaticResource ToolButtonStyle}" Click="Tool_Click" ToolTipService.ToolTip="Textmarker"><FontIcon Glyph="&#xE7E6;" FontSize="16" /></ToggleButton>
                            <ToggleButton Tag="Rectangle" Style="{StaticResource ToolButtonStyle}" Click="Tool_Click" ToolTipService.ToolTip="Rechteck"><FontIcon Glyph="&#xE739;" FontSize="16" /></ToggleButton>
                            <ToggleButton Tag="Ellipse" Style="{StaticResource ToolButtonStyle}" Click="Tool_Click" ToolTipService.ToolTip="Ellipse"><FontIcon Glyph="&#xEA3A;" FontSize="16" /></ToggleButton>
                            <ToggleButton Tag="Line" Style="{StaticResource ToolButtonStyle}" Click="Tool_Click" ToolTipService.ToolTip="Linie"><FontIcon Glyph="&#xE738;" FontSize="16" /></ToggleButton>
                            <ToggleButton Tag="Arrow" Style="{StaticResource ToolButtonStyle}" Click="Tool_Click" ToolTipService.ToolTip="Pfeil"><FontIcon Glyph="&#xE72A;" FontSize="16" /></ToggleButton>
                            <ToggleButton Tag="Whiteout" Style="{StaticResource ToolButtonStyle}" Click="Tool_Click" ToolTipService.ToolTip="Abdecken (z. B. um Text zu ersetzen)"><FontIcon Glyph="&#xE75C;" FontSize="16" /></ToggleButton>
                            <ToggleButton Tag="Redact" Style="{StaticResource ToolButtonStyle}" Click="Tool_Click" ToolTipService.ToolTip="Sicher schwärzen (Inhalt wird beim Speichern endgültig entfernt)"><FontIcon Glyph="&#xE72E;" FontSize="16" /></ToggleButton>
                            <ToggleButton Tag="Image" Style="{StaticResource ToolButtonStyle}" Click="Tool_Click" ToolTipService.ToolTip="Bild / Stempel einfügen"><FontIcon Glyph="&#xEB9F;" FontSize="16" /></ToggleButton>
                            <ToggleButton Tag="Signature" Style="{StaticResource ToolButtonStyle}" Click="Tool_Click" ToolTipService.ToolTip="Unterschreiben"><FontIcon Glyph="&#xEE56;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" /></ToggleButton>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                            <Button Click="ZoomOut_Click" ToolTipService.ToolTip="Verkleinern"><FontIcon Glyph="&#xE71F;" FontSize="12" /></Button>
                            <TextBlock x:Name="ZoomText" VerticalAlignment="Center" MinWidth="44" TextAlignment="Center" Text="100 %" />
                            <Button Click="ZoomIn_Click" ToolTipService.ToolTip="Vergrößern"><FontIcon Glyph="&#xE8A3;" FontSize="12" /></Button>
                            <Button Click="ZoomFit_Click" ToolTipService.ToolTip="Seite einpassen"><FontIcon Glyph="&#xE9A6;" FontSize="12" /></Button>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer x:Name="EditorScroll" Grid.Row="1" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto" ZoomMode="Disabled" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                  SizeChanged="EditorScroll_SizeChanged" PointerWheelChanged="EditorScroll_PointerWheelChanged">
                        <Canvas x:Name="PageOuter" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                            <Grid x:Name="PageHost" Background="White" RenderTransformOrigin="0.5,0.5"
                                  PointerPressed="PageHost_PointerPressed" PointerMoved="PageHost_PointerMoved" PointerReleased="PageHost_PointerReleased">
                                <Grid.RenderTransform>
                                    <CompositeTransform x:Name="PageTransform" />
                                </Grid.RenderTransform>
                                <Image x:Name="PageImage" Stretch="Fill" />
                                <Canvas x:Name="AnnotationCanvas" />
                                <Canvas x:Name="DraftCanvas" IsHitTestVisible="False" />
                            </Grid>
                        </Canvas>
                    </ScrollViewer>
                    <StackPanel x:Name="EmptyPanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <FontIcon Glyph="&#xE8A5;" FontSize="48" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="PDFs oder Bilder hier ablegen" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                        <TextBlock Text="Mehrere Dateien werden automatisch zusammengeführt." Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <Button Content="Dateien öffnen" Style="{StaticResource AccentButtonStyle}" Click="Open_Click" />
                            <Button Content="Leeres Dokument" Click="NewBlank_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Eigenschaften -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="0">
                <ScrollViewer Padding="12">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="PropsTitle" Text="Werkzeug" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,0,0,6" />
                        <toolkit:SettingsCard x:Name="TextCard" Header="Text" ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                            <TextBox x:Name="TextInput" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" Text="Text" TextChanged="TextInput_TextChanged" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Header="Schrift">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ComboBox x:Name="FontBox" Width="130" SelectionChanged="Prop_Changed" />
                                <NumberBox x:Name="FontSizeBox" Width="70" Minimum="4" Maximum="200" Value="14" SpinButtonPlacementMode="Hidden" ValueChanged="PropNumber_Changed" />
                            </StackPanel>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Header="Fett / Kursiv">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <ToggleButton x:Name="BoldToggle" Click="Prop_Click"><FontIcon Glyph="&#xE8DD;" FontSize="14" /></ToggleButton>
                                <ToggleButton x:Name="ItalicToggle" Click="Prop_Click"><FontIcon Glyph="&#xE8DB;" FontSize="14" /></ToggleButton>
                            </StackPanel>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Header="Farbe">
                            <DropDownButton x:Name="StrokeColorButton">
                                <Border x:Name="StrokeSwatch" Width="36" Height="18" CornerRadius="3" Background="#E81123" />
                                <DropDownButton.Flyout>
                                    <Flyout>
                                        <ColorPicker x:Name="StrokePicker" IsAlphaEnabled="False" IsMoreButtonVisible="False" IsHexInputVisible="True" ColorChanged="StrokePicker_ColorChanged" />
                                    </Flyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Header="Füllung">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <CheckBox x:Name="FillCheck" MinWidth="0" Click="Prop_Click" />
                                <DropDownButton>
                                    <Border x:Name="FillSwatch" Width="36" Height="18" CornerRadius="3" Background="#FFF100" />
                                    <DropDownButton.Flyout>
                                        <Flyout>
                                            <ColorPicker x:Name="FillPicker" IsAlphaEnabled="False" IsMoreButtonVisible="False" IsHexInputVisible="True" ColorChanged="FillPicker_ColorChanged" />
                                        </Flyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                            </StackPanel>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Header="Strichstärke">
                            <NumberBox x:Name="StrokeBox" Width="90" Minimum="0.25" Maximum="40" Value="2" SmallChange="0.5" SpinButtonPlacementMode="Compact" ValueChanged="PropNumber_Changed" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard Header="Deckkraft">
                            <Slider x:Name="OpacitySlider" Width="140" Minimum="5" Maximum="100" Value="100" ValueChanged="Opacity_Changed" />
                        </toolkit:SettingsCard>
                        <Button x:Name="DeleteAnnotationButton" Content="Ausgewählte Anmerkung löschen" HorizontalAlignment="Stretch" Click="DeleteAnnotation_Click" IsEnabled="False" />

                        <TextBlock Text="Texterkennung (OCR)" Style="{StaticResource SectionHeaderStyle}" />
                        <ComboBox x:Name="OcrLangBox" Header="Sprache" HorizontalAlignment="Stretch" />
                        <Button Content="Text auf dieser Seite erkennen" HorizontalAlignment="Stretch" Click="Ocr_Click" Style="{StaticResource AccentButtonStyle}" />
                        <TextBox x:Name="OcrText" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" MaxHeight="300" IsReadOnly="True"
                                 PlaceholderText="Erkannter Text erscheint hier. Die Seite wird beim Speichern durchsuchbar." ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        <Button Content="Text kopieren" HorizontalAlignment="Stretch" Click="CopyOcr_Click" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="3" MinHeight="32">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Seiten per Drag &amp; Drop sortieren · Strg/Umschalt für Mehrfachauswahl · Entf löscht Anmerkung oder Seiten" />
            <StackPanel x:Name="BusyPanel" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                <TextBlock x:Name="BusyText" VerticalAlignment="Center" />
                <ProgressBar x:Name="BusyBar" Width="220" Maximum="100" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
