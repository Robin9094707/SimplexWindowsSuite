<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SimplexSuite.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel MaxWidth="1000" Padding="40,28,40,40" Spacing="4">
            <TextBlock Text="Einstellungen" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12" />

            <TextBlock Text="Darstellung" Style="{StaticResource SectionHeaderStyle}" />
            <toolkit:SettingsCard Header="App-Design" Description="Hell, dunkel oder wie Windows">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE790;" /></toolkit:SettingsCard.HeaderIcon>
                <ComboBox x:Name="ThemeBox" MinWidth="200" SelectionChanged="ThemeBox_SelectionChanged">
                    <ComboBoxItem Content="Windows-Standard" Tag="System" />
                    <ComboBoxItem Content="Hell" Tag="Light" />
                    <ComboBoxItem Content="Dunkel" Tag="Dark" />
                </ComboBox>
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Hintergrundmaterial" Description="Mica ist das Windows-11-Material (unter Windows 10 wird Acryl verwendet)">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE771;" /></toolkit:SettingsCard.HeaderIcon>
                <ComboBox x:Name="BackdropBox" MinWidth="200" SelectionChanged="BackdropBox_SelectionChanged">
                    <ComboBoxItem Content="Mica" Tag="Mica" />
                    <ComboBoxItem Content="Mica Alt" Tag="MicaAlt" />
                    <ComboBoxItem Content="Acryl" Tag="Acrylic" />
                    <ComboBoxItem Content="Keins" Tag="None" />
                </ComboBox>
            </toolkit:SettingsCard>

            <TextBlock Text="Spracherkennung (lokal, offline)" Style="{StaticResource SectionHeaderStyle}" />
            <toolkit:SettingsExpander x:Name="ModelsExpander" Header="Whisper-Modelle"
                                      Description="Modelle laufen vollständig auf deinem PC. Für 8 GB RAM empfohlen: Large v3 Turbo (Q5) oder Small."
                                      IsExpanded="True">
                <toolkit:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE1D6;" /></toolkit:SettingsExpander.HeaderIcon>
            </toolkit:SettingsExpander>
            <toolkit:SettingsCard Header="Standardmodell">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE945;" /></toolkit:SettingsCard.HeaderIcon>
                <ComboBox x:Name="DefaultModelBox" MinWidth="240" SelectionChanged="DefaultModelBox_SelectionChanged" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Sprache" Description="Sprache der Aufnahme">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xF2B7;" /></toolkit:SettingsCard.HeaderIcon>
                <ComboBox x:Name="LanguageBox" MinWidth="240" SelectionChanged="LanguageBox_SelectionChanged" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="CPU-Threads" Description="Mehr Threads = schneller, aber höhere Auslastung">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE950;" /></toolkit:SettingsCard.HeaderIcon>
                <NumberBox x:Name="ThreadsBox" Minimum="1" Maximum="64" SpinButtonPlacementMode="Inline" MinWidth="160" ValueChanged="ThreadsBox_ValueChanged" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Wörtliche Transkription" Description="Füllwörter wie „äh“ und „ähm“ mit erkennen (für den Füllwort-Schnitt)">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8D2;" /></toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="VerbatimSwitch" Toggled="VerbatimSwitch_Toggled" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Füllwörter" Description="Kommagetrennte Liste für „Füllwörter finden“">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8C6;" /></toolkit:SettingsCard.HeaderIcon>
                <TextBox x:Name="FillerBox" MinWidth="320" LostFocus="FillerBox_LostFocus" />
            </toolkit:SettingsCard>

            <TextBlock Text="Audio" Style="{StaticResource SectionHeaderStyle}" />
            <toolkit:SettingsCard Header="Arbeits-Abtastrate" Description="Dateien werden beim Öffnen in diese Rate umgewandelt">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE995;" /></toolkit:SettingsCard.HeaderIcon>
                <ComboBox x:Name="RateBox" MinWidth="160" SelectionChanged="RateBox_SelectionChanged">
                    <ComboBoxItem Content="44.100 Hz" Tag="44100" />
                    <ComboBoxItem Content="48.000 Hz" Tag="48000" />
                </ComboBox>
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Als Mono bearbeiten" Description="Halbiert den Speicherbedarf – ideal für Sprachaufnahmen und PCs mit 8 GB RAM">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7F5;" /></toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="MonoSwitch" Toggled="MonoSwitch_Toggled" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Speicher für „Rückgängig“" Description="Maximaler Arbeitsspeicher für Bearbeitungsschritte (MB)">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7A7;" /></toolkit:SettingsCard.HeaderIcon>
                <NumberBox x:Name="UndoBox" Minimum="64" Maximum="16384" SmallChange="128" LargeChange="512" SpinButtonPlacementMode="Inline" MinWidth="160" ValueChanged="UndoBox_ValueChanged" />
            </toolkit:SettingsCard>

            <TextBlock Text="Medien-Engine" Style="{StaticResource SectionHeaderStyle}" />
            <toolkit:SettingsCard x:Name="FfmpegCard" Header="FFmpeg" Description="Wird mit der App ausgeliefert. Optional eigenen Ordner mit ffmpeg.exe angeben.">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE90B;" /></toolkit:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="FfmpegBox" MinWidth="260" PlaceholderText="Mitgeliefert" LostFocus="FfmpegBox_LostFocus" />
                    <Button Content="Durchsuchen" Click="BrowseFfmpeg_Click" />
                </StackPanel>
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Temporäre Dateien" Description="Vorschauen und Zwischenergebnisse löschen">
                <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE74D;" /></toolkit:SettingsCard.HeaderIcon>
                <Button Content="Aufräumen" Click="Cleanup_Click" />
            </toolkit:SettingsCard>

            <TextBlock Text="Info" Style="{StaticResource SectionHeaderStyle}" />
            <toolkit:SettingsExpander Header="Simplex Suite" x:Name="AboutExpander">
                <toolkit:SettingsExpander.HeaderIcon><BitmapIcon UriSource="ms-appx:///Assets/AppIcon.png" ShowAsMonochrome="False" /></toolkit:SettingsExpander.HeaderIcon>
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard HorizontalContentAlignment="Left" ContentAlignment="Left">
                        <TextBlock TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            Kostenlos und quelloffen. Verwendet: FFmpeg (GPL), whisper.cpp / Whisper.net (MIT), RNNoise (BSD), PDFsharp (MIT), NAudio (MIT), Windows App SDK und Windows Community Toolkit (MIT).
                        </TextBlock>
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Datenordner" x:Name="DataFolderCard" IsClickEnabled="True" Click="DataFolder_Click" />
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
